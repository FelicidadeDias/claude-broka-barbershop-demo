<!DOCTYPE html>
<html lang="pt">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Claude Broka Barbershop | Luanda</title>

<meta name="description" content="Claude Broka Barbershop — estilo, precisão e cuidado masculino em Luanda. Conheça a demonstração e agende pelo WhatsApp.">
<meta name="theme-color" content="#0b0b0b">

<style>
:root{
  --gold:#d6a84f;
  --gold-light:#f0cf7a;
  --black:#080808;
  --dark:#101010;
  --dark-2:#171717;
  --text:#fff;
  --muted:#aaa;
  --border:rgba(255,255,255,.10);
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  background:var(--black);
  color:var(--text);
  line-height:1.6;
}

body::-webkit-scrollbar{
  width:8px;
}

body::-webkit-scrollbar-track{
  background:#080808;
}

body::-webkit-scrollbar-thumb{
  background:#555;
  border-radius:20px;
}

a{
  color:inherit;
  text-decoration:none;
}

img{
  display:block;
  width:100%;
}

.container{
  width:min(1120px,92%);
  margin:auto;
}

/* =========================
   HEADER
========================= */

header{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:1000;
  background:rgba(5,5,5,.92);
  backdrop-filter:blur(12px);
  border-bottom:1px solid var(--border);
}

.nav{
  min-height:72px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.logo{
  font-size:1.05rem;
  font-weight:900;
  letter-spacing:1.5px;
}

.logo span{
  color:var(--gold);
}

nav{
  display:flex;
  align-items:center;
  gap:24px;
}

nav a{
  color:#ddd;
  font-size:.88rem;
  transition:.3s;
}

nav a:hover{
  color:var(--gold);
}

.nav-button{
  padding:10px 15px;
  border:1px solid rgba(214,168,79,.6);
  border-radius:7px;
  color:var(--gold);
}

/* =========================
   HERO
========================= */

.hero{
  min-height:100vh;
  display:flex;
  align-items:center;
  position:relative;
  overflow:hidden;

  background:
    linear-gradient(
      90deg,
      rgba(0,0,0,.88) 0%,
      rgba(0,0,0,.68) 50%,
      rgba(0,0,0,.78) 100%
    ),
    url("https://images.unsplash.com/photo-1503951914875-452162b0f3f1?auto=format&fit=crop&w=2000&q=85")
    center/cover no-repeat;
}

.hero-content{
  padding-top:70px;
  max-width:780px;
}

.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:8px 14px;
  border:1px solid rgba(214,168,79,.55);
  border-radius:100px;
  color:var(--gold-light);
  background:rgba(0,0,0,.35);
  font-size:.75rem;
  font-weight:800;
  letter-spacing:1.5px;
  text-transform:uppercase;
  margin-bottom:22px;
}

.hero h1{
  font-size:clamp(3rem,8vw,6.5rem);
  line-height:.94;
  letter-spacing:-3px;
  text-transform:uppercase;
  margin-bottom:25px;
}

.hero h1 span{
  color:var(--gold);
}

.hero p{
  max-width:650px;
  color:#ddd;
  font-size:1.08rem;
  margin-bottom:32px;
}

.buttons{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:50px;
  padding:0 21px;
  border-radius:8px;
  font-weight:800;
  font-size:.92rem;
  transition:.3s;
}

.btn-primary{
  background:var(--gold);
  color:#090909;
}

.btn-primary:hover{
  background:var(--gold-light);
  transform:translateY(-2px);
}

.btn-outline{
  border:1px solid rgba(255,255,255,.35);
  color:white;
}

.btn-outline:hover{
  background:white;
  color:#111;
}

/* =========================
   GENERAL SECTIONS
========================= */

section{
  padding:95px 0;
}

.section-heading{
  max-width:700px;
  margin:0 auto 48px;
  text-align:center;
}

.section-heading .label{
  color:var(--gold);
  font-size:.75rem;
  font-weight:900;
  letter-spacing:2px;
  text-transform:uppercase;
}

.section-heading h2{
  font-size:clamp(2rem,5vw,3.5rem);
  line-height:1.05;
  margin:10px 0 15px;
}

.section-heading p{
  color:var(--muted);
}

/* =========================
   HIGHLIGHTS
========================= */

.highlights{
  background:#0c0c0c;
}

.highlight-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}

.visual-card{
  position:relative;
  min-height:340px;
  overflow:hidden;
  border-radius:18px;
  border:1px solid var(--border);
  background:#111;
}

.visual-card img{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.5s;
}

.visual-card:hover img{
  transform:scale(1.06);
}

.visual-card::after{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(
      to top,
      rgba(0,0,0,.95) 5%,
      rgba(0,0,0,.55) 48%,
      rgba(0,0,0,.05) 100%
    );
}

.visual-content{
  position:absolute;
  left:24px;
  right:24px;
  bottom:24px;
  z-index:2;
}

.visual-icon{
  font-size:2rem;
  margin-bottom:7px;
}

.visual-content h3{
  font-size:1.5rem;
  margin-bottom:5px;
}

.visual-content p{
  color:#ccc;
  font-size:.9rem;
}

/* =========================
   SERVICES
========================= */

.services{
  background:#111;
}

.service-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.service{
  padding:30px 25px;
  border-radius:16px;
  border:1px solid var(--border);
  background:#171717;
  transition:.3s;
}

.service:hover{
  transform:translateY(-4px);
  border-color:rgba(214,168,79,.4);
}

.service-icon{
  width:54px;
  height:54px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:12px;
  background:#222;
  font-size:1.7rem;
  margin-bottom:18px;
}

.service h3{
  font-size:1.2rem;
  margin-bottom:8px;
}

.service p{
  color:var(--muted);
  font-size:.9rem;
}

/* =========================
   ABOUT
========================= */

.about{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:55px;
  align-items:center;
}

.about-image{
  position:relative;
  height:520px;
  overflow:hidden;
  border-radius:20px;
}

.about-image img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.about-image::after{
  content:"";
  position:absolute;
  inset:0;
  border:1px solid rgba(255,255,255,.1);
  border-radius:20px;
}

.about-text .label{
  color:var(--gold);
  font-size:.75rem;
  font-weight:900;
  letter-spacing:2px;
}

.about-text h2{
  font-size:clamp(2.2rem,5vw,3.8rem);
  line-height:1.05;
  margin:12px 0 22px;
}

.about-text h2 span{
  color:var(--gold);
}

.about-text p{
  color:#aaa;
  margin-bottom:16px;
}

.about-points{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin:25px 0 28px;
}

.point{
  display:flex;
  gap:9px;
  align-items:center;
  color:#ddd;
  font-size:.9rem;
}

.point strong{
  color:var(--gold);
}

/* =========================
   GALLERY
========================= */

.gallery-section{
  background:#0c0c0c;
}

.gallery{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}

.gallery-item{
  height:290px;
  overflow:hidden;
  border-radius:14px;
  background:#151515;
  border:1px solid var(--border);
}

.gallery-item img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.5s;
}

.gallery-item:hover img{
  transform:scale(1.06);
}

/* =========================
   EXPERIENCE
========================= */

.experience{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:45px;
  align-items:center;
}

.experience-image{
  height:430px;
  overflow:hidden;
  border-radius:20px;
}

.experience-image img{
  height:100%;
  object-fit:cover;
}

.experience-text .label{
  color:var(--gold);
  font-size:.75rem;
  font-weight:900;
  letter-spacing:2px;
}

.experience-text h2{
  font-size:clamp(2rem,5vw,3.3rem);
  line-height:1.05;
  margin:10px 0 18px;
}

.experience-text p{
  color:#aaa;
  margin-bottom:15px;
}

.experience-list{
  list-style:none;
  margin:22px 0 28px;
}

.experience-list li{
  padding:10px 0;
  border-bottom:1px solid var(--border);
  color:#ddd;
}

.experience-list li::before{
  content:"✓";
  color:var(--gold);
  font-weight:bold;
  margin-right:10px;
}

/* =========================
   LOCATION
========================= */

.location{
  background:#111;
}

.location-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}

.info-card{
  padding:32px;
  border-radius:18px;
  background:#181818;
  border:1px solid var(--border);
}

.info-card .big-icon{
  font-size:2rem;
  margin-bottom:12px;
}

.info-card h3{
  font-size:1.25rem;
  margin-bottom:10px;
}

.info-card p{
  color:#aaa;
}

.contact-number{
  color:var(--gold-light);
  font-size:1.2rem;
  font-weight:900;
  display:block;
  margin:8px 0 20px;
}

/* =========================
   CTA
========================= */

.cta{
  position:relative;
  overflow:hidden;
  text-align:center;

  background:
    linear-gradient(
      rgba(0,0,0,.76),
      rgba(0,0,0,.9)
    ),
    url("https://images.unsplash.com/photo-1622286342621-4bd786c2447c?auto=format&fit=crop&w=2000&q=85")
    center/cover no-repeat;
}

.cta-content{
  max-width:750px;
  margin:auto;
}

.cta h2{
  font-size:clamp(2.2rem,6vw,4.5rem);
  line-height:1;
  margin-bottom:18px;
}

.cta h2 span{
  color:var(--gold);
}

.cta p{
  color:#ccc;
  margin-bottom:28px;
}

/* =========================
   DEMO NOTICE
========================= */

.demo-notice{
  background:#090909;
  border-top:1px solid var(--border);
  border-bottom:1px solid var(--border);
  padding:14px 20px;
  text-align:center;
  color:#777;
  font-size:.72rem;
}

/* =========================
   FOOTER
========================= */

footer{
  background:#050505;
  padding:35px 0;
  text-align:center;
}

.footer-logo{
  font-weight:900;
  letter-spacing:1.5px;
  margin-bottom:8px;
}

.footer-logo span{
  color:var(--gold);
}

footer p{
  color:#666;
  font-size:.8rem;
}

/* =========================
   WHATSAPP
========================= */

.whatsapp{
  position:fixed;
  right:18px;
  bottom:18px;
  width:60px;
  height:60px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#25d366;
  color:#fff;
  font-size:28px;
  z-index:2000;
  box-shadow:0 8px 28px rgba(0,0,0,.5);
  transition:.3s;
}

.whatsapp:hover{
  transform:scale(1.08);
}

/* =========================
   MOBILE
========================= */

@media(max-width:850px){

  nav{
    display:none;
  }

  .highlight-grid,
  .service-grid,
  .gallery,
  .location-grid,
  .about,
  .experience{
    grid-template-columns:1fr;
  }

  .hero{
    min-height:92vh;
  }

  .hero h1{
    letter-spacing:-2px;
  }

  .about-image{
    height:390px;
  }

  .experience-image{
    height:350px;
  }

  .gallery-item{
    height:330px;
  }

  .about-points{
    grid-template-columns:1fr;
  }

  section{
    padding:75px 0;
  }
}

@media(max-width:480px){

  .container{
    width:min(94%,1120px);
  }

  .logo{
    font-size:.9rem;
  }

  .hero h1{
    font-size:3rem;
  }

  .hero p{
    font-size:.98rem;
  }

  .buttons{
    flex-direction:column;
  }

  .btn{
    width:100%;
  }

  .visual-card{
    min-height:300px;
  }

  .info-card{
    padding:25px;
  }

  .whatsapp{
    width:56px;
    height:56px;
    right:15px;
    bottom:15px;
  }
}
</style>
</head>

